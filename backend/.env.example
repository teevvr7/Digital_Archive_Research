# ==== Supabase ====
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # backend ONLY — never expose to the frontend
SUPABASE_JWT_SECRET=your-jwt-secret               # Project Settings > API > JWT Secret (HS256)
SUPABASE_STORAGE_BUCKET=documents

# ==== Database ====
# API uses the TRANSACTION pooler (port 6543). +psycopg = psycopg3 driver.
DATABASE_URL=postgresql+psycopg://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres
# Alembic uses the DIRECT / session connection (port 5432).
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
# Disable server-side prepared statements (required for the transaction pooler).
DB_PREPARE_THRESHOLD=none

# ==== Redis / queue ====
REDIS_URL=redis://localhost:6379/0
IDP_QUEUE_NAME=idp

# ==== VLM (self-hosted vLLM on Lightning AI Studio, OpenAI-compatible) ====
VLM_BASE_URL=https://your-lightning-endpoint/v1
VLM_API_KEY=your-vlm-key
VLM_MODEL=Qwen2.5-VL-7B-Instruct

# ==== IDP tuning ====
CONFIDENCE_THRESHOLD=0.7
PROMOTE_AFTER_N=3
VLM_MAX_PAGES=3              # cap pages sent to the VLM per document
MAX_UPLOAD_MB=50

# ==== App ====
CORS_ALLOW_ORIGINS=http://localhost:3000
SENTRY_DSN=
ENV=development
